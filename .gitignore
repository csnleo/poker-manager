# Single ignore file for the whole repository.
# Only source code and the configuration required to build the app are committed.

# --- Dependencies ---
node_modules/

# --- Build outputs ---
/build/
/dist/
/dist-ssr/
/coverage/
*.tsbuildinfo
*.local

# --- Rust / Tauri generated files ---
/src-tauri/target/
/src-tauri/gen/

# --- User data (saved ranges stay on this machine) ---
/ranges/

# --- Secrets & environment ---
.env
.env.*

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors & IDEs ---
.vscode/
.idea/
.fleet/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- Local tool settings ---
.claude/

# --- macOS ---
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
